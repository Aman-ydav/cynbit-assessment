{
  "name": "@bitelevate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API for the BitElevate Path Generator.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
