# ── Server (Express) ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty in development to use a throwaway in-memory MongoDB.
MONGODB_URI=

# Admin dashboard (/admin). Required in production.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Public base URL of the deployed app, e.g. https://paths.example.com (no trailing slash).
# Used for absolute links in share previews, the sitemap and emails — never the Host header.
PUBLIC_URL=

# Number of reverse-proxy hops to trust when reading the client IP (1 for most hosts).
TRUST_PROXY=1

# Only needed if the client is hosted on a different origin than the API.
CLIENT_ORIGIN=

# Optional: send the plan by email through Resend. The option is offered only if BOTH of
# these and PUBLIC_URL are set; otherwise it is hidden so the UI never promises an email.
RESEND_API_KEY=
EMAIL_FROM=

# ── Client (Vite, build-time) ────────────────────────────────────
# Optional Google Analytics 4 measurement id.
VITE_GA_ID=
# Where "Enrol" sends the student.
VITE_ENROL_URL=https://www.cynbit.in/bitelevate
